generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model credit_cards {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String  @db.Uuid
  name          String  @db.VarChar(100)
  last4         String? @db.Char(4)
  credit_limit  Decimal @db.Decimal(12, 2)
  statement_day Int     @db.SmallInt
  due_day       Int     @db.SmallInt
  users         users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exits         exits[]

  @@index([user_id], map: "idx_credit_cards_user_id")
}

model loans {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String          @db.Uuid
  name          String          @db.VarChar(150)
  direction     loan_direction
  principal     Decimal         @db.Decimal(12, 2)
  interest_rate Decimal         @default(0) @db.Decimal(7, 4)
  start_date    DateTime        @db.Date
  due_date      DateTime?       @db.Date
  status        loan_status     @default(active)
  loan_payments loan_payments[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_loans_user_id")
}

model reminders {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String              @db.Uuid
  title      String              @db.VarChar(200)
  amount     Decimal?            @db.Decimal(12, 2)
  due_at     DateTime            @db.Timestamptz(6)
  recurrence reminder_recurrence @default(none)
  status     reminder_status     @default(pending)
  users      users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, due_at], map: "idx_reminders_user_due")
}

model users {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(150)
  email          String           @unique @db.VarChar(255)
  avatar_url     String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  accounts       accounts[]
  categories     categories[]
  credit_cards   credit_cards[]
  entries        entries[]
  exits          exits[]
  loans          loans[]
  oauth_accounts oauth_accounts[]
  reminders      reminders[]
  savings        savings[]
  sessions       sessions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  name            String    @db.VarChar(100)
  opening_balance Decimal   @default(0) @db.Decimal(12, 2)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entries         entries[]
  exits           exits[]

  @@index([user_id], map: "idx_accounts_user_id")
}

model categories {
  id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String?       @db.Uuid
  name    String        @db.VarChar(100)
  type    category_type
  users   users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entries entries[]
  exits   exits[]

  @@index([user_id], map: "idx_categories_user_id")
  @@index([user_id, type], map: "idx_categories_user_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model entries {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  category_id String     @db.Uuid
  account_id  String?    @db.Uuid
  amount      Decimal    @db.Decimal(12, 2)
  date        DateTime   @db.Date
  description String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  accounts    accounts?  @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  categories  categories @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id], map: "idx_entries_account_id")
  @@index([category_id], map: "idx_entries_category_id")
  @@index([user_id, date], map: "idx_entries_user_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model exits {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String        @db.Uuid
  category_id    String        @db.Uuid
  account_id     String?       @db.Uuid
  credit_card_id String?       @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @db.Date
  description    String?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  accounts       accounts?     @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  categories     categories    @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  credit_cards   credit_cards? @relation(fields: [credit_card_id], references: [id], onUpdate: NoAction)
  users          users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id], map: "idx_exits_account_id")
  @@index([category_id], map: "idx_exits_category_id")
  @@index([credit_card_id], map: "idx_exits_credit_card_id")
  @@index([user_id, date], map: "idx_exits_user_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model loan_payments {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id String   @db.Uuid
  amount  Decimal  @db.Decimal(12, 2)
  paid_at DateTime @default(now()) @db.Timestamptz(6)
  note    String?
  loans   loans    @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([loan_id], map: "idx_loan_payments_loan_id")
}

model oauth_accounts {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String         @db.Uuid
  provider         oauth_provider
  provider_user_id String         @db.VarChar(255)
  users            users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_user_id], map: "uq_oauth_provider_user")
  @@index([user_id], map: "idx_oauth_accounts_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model savings {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  name           String    @db.VarChar(150)
  target_amount  Decimal   @db.Decimal(12, 2)
  current_amount Decimal   @default(0) @db.Decimal(12, 2)
  target_date    DateTime? @db.Date
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_savings_user_id")
}

model sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_sessions_expires_at")
  @@index([user_id], map: "idx_sessions_user_id")
}

enum category_type {
  income
  expense
}

enum loan_direction {
  borrowed
  lent
}

enum loan_status {
  active
  paid
}

enum oauth_provider {
  google
  github
}

enum reminder_recurrence {
  none
  monthly
  yearly
}

enum reminder_status {
  pending
  done
}
