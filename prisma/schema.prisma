generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model loans {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String          @db.Uuid
  name          String          @db.VarChar(150)
  direction     loan_direction
  principal     Decimal         @db.Decimal(12, 2)
  interest_rate Decimal         @default(0) @db.Decimal(7, 4)
  start_date    DateTime        @db.Date
  due_date      DateTime?       @db.Date
  status        loan_status     @default(active)
  loan_payments loan_payments[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_loans_user_id")
}

model reminders {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String              @db.Uuid
  title      String              @db.VarChar(200)
  amount     Decimal?            @db.Decimal(12, 2)
  due_at     DateTime            @db.Timestamptz(6)
  recurrence reminder_recurrence @default(none)
  status     reminder_status     @default(pending)
  users      users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, due_at], map: "idx_reminders_user_due")
}

model users {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(150)
  email          String           @unique @db.VarChar(255)
  avatar_url     String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  accounts       accounts[]
  categories     categories[]
  loans          loans[]
  oauth_accounts oauth_accounts[]
  reminders      reminders[]
  savings        savings[]
  sessions       sessions[]
  transactions   transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  id                                                                           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                                      String                @db.Uuid
  name                                                                         String                @db.VarChar(100)
  opening_balance                                                              Decimal               @default(0) @db.Decimal(12, 2)
  type                                                                         account_type          @default(bank)
  opening_balance_date                                                         DateTime              @default(now()) @db.Timestamptz(6)
  is_active                                                                    Boolean               @default(true)
  account_movements                                                            account_movements[]
  users                                                                        users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  credit_card_details_credit_card_details_account_id_user_idToaccounts         credit_card_details?  @relation("credit_card_details_account_id_user_idToaccounts")
  credit_card_details_credit_card_details_payment_account_id_user_idToaccounts credit_card_details[] @relation("credit_card_details_payment_account_id_user_idToaccounts")
  debit_cards                                                                  debit_cards[]
  transfers_transfers_from_account_id_user_idToaccounts                        transfers[]           @relation("transfers_from_account_id_user_idToaccounts")
  transfers_transfers_to_account_id_user_idToaccounts                          transfers[]           @relation("transfers_to_account_id_user_idToaccounts")

  @@unique([id, user_id], map: "uq_accounts_id_user")
  @@index([user_id], map: "idx_accounts_user_id")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model categories {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?        @db.Uuid
  name         String         @db.VarChar(100)
  type         category_type
  users        users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions transactions[]

  @@index([user_id], map: "idx_categories_user_id")
  @@index([user_id, type], map: "idx_categories_user_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model loan_payments {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id String   @db.Uuid
  amount  Decimal  @db.Decimal(12, 2)
  paid_at DateTime @default(now()) @db.Timestamptz(6)
  note    String?
  loans   loans    @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([loan_id], map: "idx_loan_payments_loan_id")
}

model oauth_accounts {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String         @db.Uuid
  provider         oauth_provider
  provider_user_id String         @db.VarChar(255)
  users            users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_user_id], map: "uq_oauth_provider_user")
  @@index([user_id], map: "idx_oauth_accounts_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model savings {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  name           String    @db.VarChar(150)
  target_amount  Decimal   @db.Decimal(12, 2)
  current_amount Decimal   @default(0) @db.Decimal(12, 2)
  target_date    DateTime? @db.Date
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_savings_user_id")
}

model sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_sessions_expires_at")
  @@index([user_id], map: "idx_sessions_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model account_movements {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String       @db.Uuid
  transaction_id String       @db.Uuid
  account_id     String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  accounts       accounts     @relation(fields: [account_id, user_id], references: [id, user_id], onUpdate: NoAction, map: "fk_movement_account")
  transactions   transactions @relation(fields: [transaction_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_movement_transaction")

  @@index([account_id], map: "idx_movements_account")
  @@index([transaction_id], map: "idx_movements_transaction")
  @@index([user_id, account_id], map: "idx_movements_user_account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model credit_card_details {
  id                                                                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id                                                        String    @unique @db.Uuid
  last4                                                             String?   @db.Char(4)
  credit_limit                                                      Decimal   @db.Decimal(12, 2)
  statement_day                                                     Int       @db.SmallInt
  due_day                                                           Int       @db.SmallInt
  payment_account_id                                                String?   @db.Uuid
  user_id                                                           String    @db.Uuid
  accounts_credit_card_details_account_id_user_idToaccounts         accounts  @relation("credit_card_details_account_id_user_idToaccounts", fields: [account_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ccd_account")
  accounts_credit_card_details_payment_account_id_user_idToaccounts accounts? @relation("credit_card_details_payment_account_id_user_idToaccounts", fields: [payment_account_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ccd_payment_account")

  @@unique([account_id, user_id], map: "uq_ccd_account_user")
  @@index([payment_account_id], map: "idx_ccd_payment_account")
}

model debit_cards {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String   @db.Uuid
  name       String   @db.VarChar(100)
  last4      String?  @db.Char(4)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  accounts   accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id], map: "idx_debit_cards_account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  type              transaction_type
  category_id       String?             @db.Uuid
  amount            Decimal             @db.Decimal(12, 2)
  description       String?
  occurred_at       DateTime            @default(now()) @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  account_movements account_movements[]
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transactions_user")
  categories        categories?         @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transfers         transfers?

  @@unique([id, user_id], map: "uq_transactions_id_user")
  @@index([user_id, occurred_at], map: "idx_transactions_user_date")
  @@index([user_id, type, occurred_at], map: "idx_transactions_user_type_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transfers {
  transaction_id                                       String       @id @db.Uuid
  from_account_id                                      String       @db.Uuid
  to_account_id                                        String       @db.Uuid
  fee                                                  Decimal      @default(0) @db.Decimal(12, 2)
  user_id                                              String       @db.Uuid
  accounts_transfers_from_account_id_user_idToaccounts accounts     @relation("transfers_from_account_id_user_idToaccounts", fields: [from_account_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transfers_from_account")
  accounts_transfers_to_account_id_user_idToaccounts   accounts     @relation("transfers_to_account_id_user_idToaccounts", fields: [to_account_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transfers_to_account")
  transactions                                         transactions @relation(fields: [transaction_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transfers_transaction")

  @@unique([transaction_id, user_id], map: "uq_transfers_transaction_user")
  @@index([from_account_id], map: "idx_transfers_from_account")
  @@index([to_account_id], map: "idx_transfers_to_account")
  @@index([user_id], map: "idx_transfers_user")
}

enum category_type {
  income
  expense
}

enum loan_direction {
  borrowed
  lent
}

enum loan_status {
  active
  paid
}

enum oauth_provider {
  google
  github
}

enum reminder_recurrence {
  none
  monthly
  yearly
}

enum reminder_status {
  pending
  done
}

enum account_type {
  cash
  bank
  savings
  credit_card
}

enum transaction_type {
  income
  expense
  transfer
  adjustment
}
